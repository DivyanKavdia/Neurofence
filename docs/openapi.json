  "components": {
    "parameters": {
      "Idempotency": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Version": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "Resource": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      },
      "Envelope": {
        "type": "object",
        "properties": {
          "data": {},
          "meta": {
            "type": "object",
            "properties": {
              "correlationId": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              },
              "nextCursor": {
                "type": "string"
              }
            },
            "required": [
              "correlationId",
              "revision"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "correlationId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "correlationId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ModelRequest": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "streaming": {
            "type": "boolean"
          },
          "failure": {
            "type": "string",
            "enum": [
              "",
              "timeout"
            ]
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "project",
          "prompt"
        ]
      },
      "ToolRequest": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "agent",
          "tool",
          "args"
        ]
      },
      "Inspection": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          },
          "stage": {
            "type": "string",
            "enum": [
              "Request",
              "Response",
              "Tool arguments",
              "File / OCR"
            ]
          }
        },
        "required": [
          "policy",
          "text"
        ]
      },
      "Trace": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Resource"
          },
          {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "string"
              },
              "decisionId": {
                "type": "string"
              },
              "policyVersion": {
                "type": "integer"
              },
              "project": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "principal": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "model",
                  "tool"
                ]
              },
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "executed": {
                "type": "boolean"
              },
              "cost": {
                "type": "number"
              },
              "tokens": {
                "type": "integer"
              },
              "pendingCost": {
                "type": "boolean"
              },
              "budgetScope": {
                "type": "string"
              },
              "preview": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": []
                }
              }
            },
            "required": []
          }
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "Approved",
              "Denied"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          }
        },
        "required": [
          "decision",
          "reason"
        ]
      },
      "Reason": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5
          }
        },
        "required": [
          "reason"
        ]
      },
      "Fields": {
        "type": "object",
        "description": "Collection-specific validated fields are defined in src/backend.ts and the API handoff. Unknown fields are rejected on resource create/edit.",
        "additionalProperties": true
      }
    }
  }
}
