{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@neurofence/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@neurofence/demo-backend": [
        "./packages/demo-backend/src/index.ts"
      ]
    },
    "noUnusedLocals": true
  },
  "include": [
    "apps",
    "packages"
  ]
}
