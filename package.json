{
  "name": "neurofence-prototype",
  "version": "0.4.0",
  "private": true,
  "description": "NeuralFence React console, mock BFF and Terraform backend dependency foundation",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/serve.mjs",
    "mock": "node scripts/build.mjs && node .runtime/mock-server.cjs",
    "test": "npm run typecheck && npm run build && node --test tests/backend.test.cjs tests/http.test.cjs && node tests/console.cjs",
    "test:browser": "node tests/console.cjs",
    "test:api": "node --test tests/backend.test.cjs tests/http.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
